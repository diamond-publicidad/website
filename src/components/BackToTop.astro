---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faArrowUp } from '@fortawesome/free-solid-svg-icons';
import type { Translations } from '../i18n';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
const backToTopIcon = icon(faArrowUp).html.join('');
---

<a id="back-to-top" class="scroll-top fixed bottom-5 right-5 z-30 inline-flex translate-y-4 items-center gap-2 rounded-full border border-secondary bg-primary px-4 py-3 text-sm font-bold text-secondary opacity-0 shadow-lg transition duration-200 pointer-events-none hover:-translate-y-0.5 hover:bg-white hover:text-secondary focus-visible:bg-white focus-visible:text-secondary dark:text-secondary dark:hover:bg-white dark:hover:text-secondary dark:focus-visible:bg-white dark:focus-visible:text-secondary" href="#inicio" aria-label={translations.backToTop.label}><span aria-hidden="true" set:html={backToTopIcon}></span><span class="hidden sm:inline">{translations.backToTop.text}</span></a>

<script>
  const scrollToTop = (event: MouseEvent) => {
    event.preventDefault();
    document.scrollingElement?.scrollTo({
      top: 0,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
    });
  };

  const backToTop = document.querySelector<HTMLAnchorElement>('#back-to-top');
  backToTop?.addEventListener('click', scrollToTop);


  if (backToTop) {
    const updateBackToTop = () => {
      const isVisible = window.scrollY > 480;
      backToTop.classList.toggle('opacity-0', !isVisible);
      backToTop.classList.toggle('translate-y-4', !isVisible);
      backToTop.classList.toggle('pointer-events-none', !isVisible);
    };

    window.addEventListener('scroll', updateBackToTop, { passive: true });
    updateBackToTop();
  }
</script>