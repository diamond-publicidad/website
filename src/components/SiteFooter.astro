---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons';
import { siteVersion, siteVersionDate, type Translations } from '../i18n';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
const currentYear = new Date().getFullYear();
const githubIcon = icon(faGithub).html.join('');
const linkedinIcon = icon(faLinkedin).html.join('');
---

<footer class="bg-[#171717] px-5 pb-10 text-sm text-white sm:px-8 sm:pb-8 lg:px-12">
  <div class="mx-auto flex max-w-7xl justify-center border-t border-gray-700 pt-5 text-center">
    <div class="flex flex-col items-center gap-2">
      <p class="leading-relaxed text-white">&copy; {currentYear} Diamond Publicidad. {translations.footer.copyright}</p>

      <div class="flex flex-col items-center gap-1 text-center">
        <p class="flex flex-wrap items-center justify-center gap-1.5 text-[0.65rem] uppercase tracking-[0.14em] text-gray-400">
          <span>{translations.footer.madeBy}</span>
          <span class="text-sm font-semibold normal-case tracking-normal text-white">Julian Ospina</span>
        </p>

        <p class="text-xs text-white/80">{translations.footer.developerDescription}</p>

        <div class="flex items-center justify-center gap-3 text-white">
          <a class="group inline-flex h-7 w-7 items-center justify-center rounded-full text-white transition-all duration-200 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#171717]" href="https://github.com/xhate83" target="_blank" rel="noreferrer" aria-label={translations.footer.githubLabel}>
            <span class="text-base" aria-hidden="true" set:html={githubIcon}></span>
            <span class="sr-only">GitHub</span>
          </a>
          <a class="group inline-flex h-7 w-7 items-center justify-center rounded-full text-white transition-all duration-200 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#171717]" href="https://www.linkedin.com/in/jeyson-julian-ospina-leon-14b4aa1aa/" target="_blank" rel="noreferrer" aria-label={translations.footer.linkedinLabel}>
            <span class="text-base" aria-hidden="true" set:html={linkedinIcon}></span>
            <span class="sr-only">LinkedIn</span>
          </a>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2 text-[0.68rem] font-medium uppercase tracking-[0.14em] text-white/80">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-700 bg-white/5 px-2.5 py-1 text-white">
          <span aria-hidden="true">v</span>
          <span>{siteVersion}</span>
        </span>
        <span class="hidden text-white/60 sm:inline">•</span>
        <span>{siteVersionDate}</span>
      </div>
    </div>
  </div>
</footer>