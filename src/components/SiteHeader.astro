---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons';
import { faBars, faBuilding, faBriefcase, faChevronRight, faCode, faHeadset, faGem, faMoon, faSliders, faSun, faXmark } from '@fortawesome/free-solid-svg-icons';
import { languageStorageKey, siteVersion, siteVersionDate, type Locale, type Translations } from '../i18n';

interface Props {
  locale: Locale;
  translations: Translations;
}

const { locale, translations } = Astro.props;
const siteBasePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${siteBasePath}/${locale.slug}/`;
const storyHref = `${siteBasePath}/${locale.slug}/nuestra-historia`;
const servicesHref = `${siteBasePath}/${locale.slug}/#servicios`;
const contactHref = `${siteBasePath}/${locale.slug}/#contacto`;
const moonIcon = icon(faMoon).html.join('');
const sunIcon = icon(faSun).html.join('');
const settingsIcon = icon(faSliders).html.join('');
const diamondIcon = icon(faGem).html.join('');
const infoIcon = icon(faBuilding).html.join('');
const cardDecorIcon = icon(faCode).html.join('');
const githubIcon = icon(faGithub).html.join('');
const linkedinIcon = icon(faLinkedin).html.join('');
const menuIcon = icon(faBars).html.join('');
const closeIcon = icon(faXmark).html.join('');
const servicesIcon = icon(faBriefcase).html.join('');
const contactIcon = icon(faHeadset).html.join('');
const navArrowIcon = icon(faChevronRight).html.join('');
---

<header class="site-header sticky top-0 z-40 border-b border-border bg-card/95 text-text backdrop-blur-sm dark:bg-card/88" data-language-storage-key={languageStorageKey}>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-4 sm:px-8 lg:px-12">
    <a class="site-nav-link scroll-top flex items-center gap-3 no-underline" href={homeHref} aria-label={translations.navigation.home} data-nav="home">
      <span class="text-lg text-primary" aria-hidden="true" set:html={diamondIcon}></span>
      <span class="text-base font-extrabold tracking-tight sm:text-lg">Diamond Publicidad</span>
    </a>
    <nav aria-label={translations.navigation.primary} class="flex items-center gap-4 sm:gap-7">
      <div class="settings-wrapper relative hidden sm:order-2 sm:block sm:ml-1">
        <button id="settings-button" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-border bg-card text-text shadow-[0_2px_8px_rgba(23,23,23,0.04)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-primary hover:text-primary hover:shadow-[0_8px_16px_rgba(23,23,23,0.1)] focus-visible:-translate-y-0.5 focus-visible:border-primary focus-visible:text-primary focus-visible:shadow-[0_8px_16px_rgba(23,23,23,0.1)] active:translate-y-0 active:shadow-[0_3px_8px_rgba(23,23,23,0.08)]" type="button" aria-expanded="false" aria-controls="settings-menu" aria-label={translations.theme.heading} title={translations.theme.heading}>
          <span class="text-base" aria-hidden="true" set:html={settingsIcon}></span>
        </button>
        <div id="settings-menu" class="absolute right-0 top-[calc(100%+0.5rem)] z-50 min-w-[13.5rem]" hidden>
          <div class="grid gap-[0.65rem] rounded-xl border border-border bg-card p-3 shadow-[0_16px_36px_rgb(0_0_0_/_12%)]" role="menu" aria-label={translations.theme.heading}>
            <div class="flex items-center justify-start gap-[0.65rem]">
              <label class="inline-flex h-7 cursor-pointer" title={translations.theme.label}>
                <input id="theme-toggle" class="peer sr-only" type="checkbox" role="switch" aria-checked="false" aria-label={translations.theme.dark} data-dark-label={translations.theme.dark} data-light-label={translations.theme.light} />
                <span class="relative inline-flex h-7 w-13 items-center justify-between rounded-full border border-border bg-theme-surface px-[0.35rem] text-text-muted peer-focus-visible:outline-2 peer-focus-visible:outline-focus peer-focus-visible:outline-offset-3 dark:text-gray-300">
                  <span class="relative z-10 text-sm" set:html={moonIcon}></span>
                  <span class="relative z-10 text-sm text-primary" set:html={sunIcon}></span>
                  <span class="theme-toggle-thumb absolute left-[0.2rem] top-[0.2rem] z-20 h-[1.2rem] w-[1.2rem] rounded-full bg-[linear-gradient(145deg,color-mix(in_srgb,var(--theme-text)_85%,white),var(--theme-text))] shadow-[inset_0_1px_1px_rgb(255_255_255_/_42%),inset_0_-1px_1px_rgb(0_0_0_/_28%),0_1px_3px_rgb(0_0_0_/_34%)] transition-transform duration-[180ms] ease-out peer-checked:translate-x-[1.45rem] peer-checked:bg-[linear-gradient(145deg,#ffe45c,var(--color-primary))]"></span>
                </span>
              </label>
              <span class="theme-label text-xs font-bold text-text transition-colors duration-200">{translations.theme.dark}</span>
            </div>
            <div class="flex items-center justify-start gap-4" role="group" aria-label={translations.language.label}>
              <button class="language-option group inline-flex cursor-pointer items-center justify-center gap-2 bg-transparent py-1 font-bold text-text transition-colors duration-150 hover:text-primary focus-visible:text-primary aria-pressed:text-primary" type="button" data-locale="es-co" aria-label={`${translations.language.esCO}`} aria-pressed={locale.slug === 'es-co'}><span class="inline-block h-3.5 w-5 rounded-sm border border-black/15 bg-[linear-gradient(to_bottom,#fcd116_0_50%,#003893_50%_75%,#ce1126_75%_100%)]" aria-hidden="true"></span><span class="language-label text-xs tracking-wider text-current transition-colors duration-150 group-hover:text-primary group-focus-visible:text-primary">ES</span></button>
              <button class="language-option group inline-flex cursor-pointer items-center justify-center gap-2 bg-transparent py-1 font-bold text-text transition-colors duration-150 hover:text-primary focus-visible:text-primary aria-pressed:text-primary" type="button" data-locale="en-us" aria-label={`${translations.language.enUS}`} aria-pressed={locale.slug === 'en-us'}><span class="relative inline-block h-3.5 w-5 rounded-sm border border-black/15 bg-[repeating-linear-gradient(to_bottom,#b22234_0_0.07rem,#fff_0.07rem_0.14rem)] before:absolute before:left-0 before:top-0 before:h-2 before:w-2.5 before:bg-[#3c3b6e] before:content-['']" aria-hidden="true"></span><span class="language-label text-xs tracking-wider text-current transition-colors duration-150 group-hover:text-primary group-focus-visible:text-primary">EN</span></button>
            </div>
          </div>
        </div>
      </div>
      <button id="menu-toggle" class="group inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-md border border-border bg-card text-text shadow-[0_2px_8px_rgba(23,23,23,0.04)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-primary hover:bg-primary hover:text-secondary hover:shadow-[0_8px_16px_rgba(23,23,23,0.1)] focus-visible:-translate-y-0.5 focus-visible:border-primary focus-visible:bg-primary focus-visible:text-secondary focus-visible:shadow-[0_8px_16px_rgba(23,23,23,0.1)] active:translate-y-0 active:shadow-[0_3px_8px_rgba(23,23,23,0.08)] sm:hidden" type="button" aria-controls="primary-menu" aria-expanded="false" aria-label={translations.navigation.openMenu} title={translations.navigation.openMenu} data-open-label={translations.navigation.openMenu} data-close-label={translations.navigation.closeMenu}>
        <span class="text-xl group-aria-expanded:hidden" aria-hidden="true" set:html={menuIcon}></span>
        <span class="hidden text-xl group-aria-expanded:inline" aria-hidden="true" set:html={closeIcon}></span>
      </button>
      <div id="primary-menu" class="fixed inset-x-0 top-[73px] z-60 hidden h-[calc(100dvh-73px)] flex-col gap-0 overflow-y-auto bg-card p-8 data-[open=true]:flex data-[open=true]:animate-[mobile-menu-in_160ms_ease-out_both] motion-reduce:data-[open=true]:animate-none sm:static sm:order-1 sm:flex sm:h-auto sm:flex-row sm:items-center sm:gap-7 sm:overflow-visible sm:bg-transparent sm:p-0">
        <div class="w-full sm:w-auto">
          <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-text-muted dark:text-gray-300 sm:hidden"><span class="text-sm" aria-hidden="true" set:html={menuIcon}></span>{translations.navigation.heading}</p>
          <ul class="w-full overflow-hidden border-y border-border bg-card sm:flex sm:items-center sm:gap-7 sm:border-0 sm:bg-transparent sm:p-0">
            <li class="border-b border-border last:border-b-0 sm:border-0">
              <a class="site-nav-link group relative flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left text-text no-underline transition-colors duration-200 hover:bg-theme-surface hover:text-text focus-visible:bg-theme-surface focus-visible:text-text sm:inline-flex sm:w-auto sm:items-center sm:gap-2 sm:rounded-none sm:px-0 sm:py-1 sm:text-sm sm:hover:bg-transparent sm:focus-visible:text-primary sm:after:absolute sm:after:inset-x-0 sm:after:bottom-0 sm:after:h-0.5 sm:after:origin-right sm:after:scale-x-0 sm:after:bg-primary sm:after:transition-transform sm:hover:after:origin-left sm:hover:after:scale-x-100" href={servicesHref} data-nav="services">
                <span class="flex items-center gap-3 sm:gap-1">
                  <span class="nav-icon flex h-9 w-9 items-center justify-center rounded-md bg-theme-surface text-base text-text-muted transition-colors duration-200 group-hover:text-primary group-focus-visible:text-primary sm:border-0 sm:bg-transparent" aria-hidden="true" set:html={servicesIcon}></span>
                  <span class="nav-label text-base font-semibold sm:text-sm">{translations.navigation.services}</span>
                </span>
                <span class="text-base text-text-muted transition-colors duration-200 group-hover:text-primary group-focus-visible:text-primary sm:hidden" aria-hidden="true" set:html={navArrowIcon}></span>
              </a>
            </li>
            <li class="border-b border-border last:border-b-0 sm:border-0">
              <a class="site-nav-link group relative flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left text-text no-underline transition-colors duration-200 hover:bg-theme-surface hover:text-text focus-visible:bg-theme-surface focus-visible:text-text sm:inline-flex sm:w-auto sm:items-center sm:gap-2 sm:rounded-none sm:px-0 sm:py-1 sm:text-sm sm:hover:bg-transparent sm:focus-visible:text-primary sm:after:absolute sm:after:inset-x-0 sm:after:bottom-0 sm:after:h-0.5 sm:after:origin-right sm:after:scale-x-0 sm:after:bg-primary sm:after:transition-transform sm:hover:after:origin-left sm:hover:after:scale-x-100" href={storyHref} data-nav="story">
                <span class="flex items-center gap-3 sm:gap-1">
                  <span class="nav-icon flex h-9 w-9 items-center justify-center rounded-md bg-theme-surface text-base text-text-muted transition-colors duration-200 group-hover:text-primary group-focus-visible:text-primary sm:border-0 sm:bg-transparent" aria-hidden="true" set:html={infoIcon}></span>
                  <span class="nav-label text-base font-semibold sm:text-sm">{translations.navigation.story}</span>
                </span>
                <span class="text-base text-text-muted transition-colors duration-200 group-hover:text-primary group-focus-visible:text-primary sm:hidden" aria-hidden="true" set:html={navArrowIcon}></span>
              </a>
            </li>
            <li class="border-b border-border last:border-b-0 sm:border-0">
              <a class="site-nav-link group relative flex w-full items-center justify-between gap-3 px-4 py-3.5 text-left text-text no-underline transition-colors duration-200 hover:bg-theme-surface hover:text-text focus-visible:bg-theme-surface focus-visible:text-text sm:inline-flex sm:w-auto sm:items-center sm:gap-2 sm:rounded-none sm:px-0 sm:py-1 sm:text-sm sm:hover:bg-transparent sm:focus-visible:text-primary sm:after:absolute sm:after:inset-x-0 sm:after:bottom-0 sm:after:h-0.5 sm:after:origin-right sm:after:scale-x-0 sm:after:bg-primary sm:after:transition-transform sm:hover:after:origin-left sm:hover:after:scale-x-100" href={contactHref} data-nav="contact">
                <span class="flex items-center gap-3 sm:gap-1">
                  <span class="nav-icon flex h-9 w-9 items-center justify-center rounded-md bg-theme-surface text-base text-text-muted transition-colors duration-200 group-hover:text-primary group-focus-visible:text-primary sm:border-0 sm:bg-transparent" aria-hidden="true" set:html={contactIcon}></span>
                  <span class="nav-label text-base font-semibold sm:text-sm">{translations.navigation.contact}</span>
                </span>
                <span class="text-base text-text-muted transition-colors duration-200 group-hover:text-primary group-focus-visible:text-primary sm:hidden" aria-hidden="true" set:html={navArrowIcon}></span>
              </a>
            </li>
          </ul>
        </div>
        <div class="mt-5 pt-5 sm:hidden">
          <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-text-muted dark:text-gray-300"><span class="text-sm" aria-hidden="true" set:html={settingsIcon}></span>{translations.theme.heading}</p>
          <div class="inline-flex h-10 items-center gap-3 text-sm font-semibold"><label class="inline-flex h-7 cursor-pointer" title={translations.theme.label}><input id="mobile-theme-toggle" class="peer sr-only" type="checkbox" role="switch" aria-checked="false" aria-label={translations.theme.dark} data-dark-label={translations.theme.dark} data-light-label={translations.theme.light} /><span class="relative inline-flex h-7 w-13 items-center justify-between rounded-full border border-border bg-theme-surface px-[0.35rem] text-text-muted peer-focus-visible:outline-2 peer-focus-visible:outline-focus peer-focus-visible:outline-offset-3"><span class="relative z-10 text-sm" set:html={moonIcon}></span><span class="relative z-10 text-sm text-primary" set:html={sunIcon}></span><span class="theme-toggle-thumb absolute left-[0.2rem] top-[0.2rem] z-20 h-[1.2rem] w-[1.2rem] rounded-full bg-[linear-gradient(145deg,color-mix(in_srgb,var(--theme-text)_85%,white),var(--theme-text))] shadow-[inset_0_1px_1px_rgb(255_255_255_/_42%),inset_0_-1px_1px_rgb(0_0_0_/_28%),0_1px_3px_rgb(0_0_0_/_34%)] transition-transform duration-[180ms] ease-out peer-checked:translate-x-[1.45rem] peer-checked:bg-[linear-gradient(145deg,#ffe45c,var(--color-primary))]"></span></span></label><span class="mobile-theme-label text-text">{translations.theme.dark}</span></div>
        </div>
        <div class="mt-auto flex flex-col justify-end border-t border-border pt-5 sm:hidden">
          <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-text-muted dark:text-gray-300"><span class="text-sm" aria-hidden="true" set:html={infoIcon}></span>{translations.footer.aboutSite}</p>
          <div class="flex items-center justify-between gap-4 py-[0.42rem] text-[0.82rem]"><span>{translations.footer.versionLabel}</span><strong class="font-bold text-primary">{siteVersion}</strong></div>
          <div class="flex items-center justify-between gap-4 py-[0.42rem] text-[0.82rem]"><span>{translations.footer.dateLabel}</span><span>{siteVersionDate}</span></div>
              <div class="relative mt-3 flex flex-col gap-2 overflow-hidden rounded-xl border border-border bg-theme-surface/82 p-3"><span class="pointer-events-none absolute -bottom-3 -right-3 -rotate-8 text-6xl text-text/10" aria-hidden="true" set:html={cardDecorIcon}></span><div class="flex items-center justify-between gap-4 text-xs"><span class="text-text-muted">{translations.footer.madeBy}</span><strong class="font-bold text-primary">Julian Ospina</strong></div><p class="m-0 text-xs leading-5 text-text-muted">{translations.footer.developerDescription}</p><div class="relative z-10 mt-1 flex items-center gap-3">
                <a class="text-text-muted transition-colors duration-200 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card" href="https://github.com/xhate83" target="_blank" rel="noreferrer" aria-label={translations.footer.githubLabel}>
                <span class="text-base" aria-hidden="true" set:html={githubIcon}></span>
                <span class="sr-only">GitHub</span>
              </a>
              <a class="text-text-muted transition-colors duration-200 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-card" href="https://www.linkedin.com/in/jeyson-julian-ospina-leon-14b4aa1aa/" target="_blank" rel="noreferrer" aria-label={translations.footer.linkedinLabel}>
                <span class="text-base" aria-hidden="true" set:html={linkedinIcon}></span>
                <span class="sr-only">LinkedIn</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </div>
  <div class="flex items-center justify-end gap-[0.85rem] px-5 pb-[0.9rem] sm:hidden" role="group" aria-label={translations.language.label}>
    <button class="mobile-language-option group inline-flex cursor-pointer items-center justify-center gap-2 bg-transparent px-px py-1 font-bold text-text transition-colors duration-150 hover:text-primary focus-visible:text-primary" type="button" data-locale="es-co" aria-label={`${translations.language.esCO}`} aria-pressed={locale.slug === 'es-co'}>
      <span class="inline-block h-[0.9rem] w-[1.3rem] rounded-[0.15rem] border border-black/15 bg-[linear-gradient(to_bottom,#fcd116_0_50%,#003893_50%_75%,#ce1126_75%_100%)] shadow-[inset_0_0_0_1px_rgb(255_255_255_/_18%)]" aria-hidden="true"></span>
      <span class="language-label text-[0.7rem] tracking-[0.08em] text-current transition-colors duration-150 group-hover:text-primary group-focus-visible:text-primary">ES</span>
    </button>
    <button class="mobile-language-option group inline-flex cursor-pointer items-center justify-center gap-2 bg-transparent px-px py-1 font-bold text-text transition-colors duration-150 hover:text-primary focus-visible:text-primary" type="button" data-locale="en-us" aria-label={`${translations.language.enUS}`} aria-pressed={locale.slug === 'en-us'}>
      <span class="relative inline-block h-[0.9rem] w-[1.3rem] rounded-[0.15rem] border border-black/15 bg-[repeating-linear-gradient(to_bottom,#b22234_0_0.07rem,#fff_0.07rem_0.14rem)] shadow-[inset_0_0_0_1px_rgb(255_255_255_/_18%)] before:absolute before:left-0 before:top-0 before:h-[0.48rem] before:w-[0.58rem] before:bg-[#3c3b6e] before:content-['']" aria-hidden="true"></span>
      <span class="language-label text-[0.7rem] tracking-[0.08em] text-current transition-colors duration-150 group-hover:text-primary group-focus-visible:text-primary">EN</span>
    </button>
  </div>
</header>

<style>
  .site-nav-link[data-active='true'] {
    background: var(--theme-surface);
    color: var(--theme-text);
  }

  .site-nav-link[data-active='true'] .nav-icon,
  .site-nav-link[data-active='true'] .nav-label {
    color: var(--color-primary);
  }

  .site-nav-link[data-active='true']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (min-width: 640px) {
    .site-nav-link[data-active='true'] {
      background: transparent;
      color: var(--color-primary);
    }

    .site-nav-link[data-active='true'] .nav-icon,
    .site-nav-link[data-active='true'] .nav-label {
      color: var(--color-primary);
    }
  }
</style>

<script>
  const themeStorageKey = 'diamond-publicidad-theme';
  const localeScrollStorageKey = 'diamond-publicidad-scroll';
  const languageStorageKey = document.querySelector<HTMLElement>('.site-header')?.dataset.languageStorageKey;
  const themeToggle = document.querySelector<HTMLInputElement>('#theme-toggle');
  const mobileThemeToggle = document.querySelector<HTMLInputElement>('#mobile-theme-toggle');
  const menuToggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const settingsButton = document.querySelector<HTMLButtonElement>('#settings-button');
  const settingsMenu = document.querySelector<HTMLDivElement>('#settings-menu');
  const primaryMenu = document.querySelector('#primary-menu');
  const themeLabels = document.querySelectorAll<HTMLElement>('.theme-label, .mobile-theme-label');
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  let menuOpenedByPointer = false;

  const updateThemeThumb = (toggle: HTMLInputElement | null) => {
    const thumb = toggle?.closest('label')?.querySelector<HTMLElement>('.theme-toggle-thumb');
    if (!thumb) return;
    thumb.style.transform = toggle?.checked ? 'translateX(1.45rem)' : 'translateX(0)';
  };

  const updateThemeControl = (theme: 'light' | 'dark') => {
    const isDark = theme === 'dark';

    [themeToggle, mobileThemeToggle].forEach((toggle) => {
      if (toggle) {
        toggle.checked = isDark;
        updateThemeThumb(toggle);
      }
    });

    const label = isDark ? themeToggle?.dataset.darkLabel : themeToggle?.dataset.lightLabel;
    [themeToggle, mobileThemeToggle].forEach((toggle) => {
      toggle?.setAttribute('aria-checked', String(isDark));
      if (label) toggle?.setAttribute('aria-label', label);
    });

    if (label) themeLabels.forEach((themeLabel) => {
      themeLabel.textContent = label;
      themeLabel.classList.toggle('text-primary', isDark);
    });
  };

  const setTheme = (theme: 'light' | 'dark', persist = true) => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    updateThemeControl(theme);

    if (persist) {
      try {
        localStorage.setItem(themeStorageKey, theme);
      } catch {}
    }
  };

  const initialTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  updateThemeControl(initialTheme);

  history.scrollRestoration = 'manual';

  const restoreScrollPosition = () => {
    const savedScroll = Number(sessionStorage.getItem(localeScrollStorageKey) ?? '0');
    if (!Number.isFinite(savedScroll) || savedScroll <= 0) {
      sessionStorage.removeItem(localeScrollStorageKey);
      return;
    }

    requestAnimationFrame(() => {
      window.scrollTo({ top: savedScroll, left: 0, behavior: 'auto' });
      sessionStorage.removeItem(localeScrollStorageKey);
    });
  };

  restoreScrollPosition();

  const setSettingsMenuState = (isOpen: boolean) => {
    if (!settingsButton || !settingsMenu) return;
    settingsMenu.hidden = !isOpen;
    settingsButton.setAttribute('aria-expanded', String(isOpen));
  };

  settingsButton?.addEventListener('click', (event) => {
    event.stopPropagation();
    const nextState = settingsButton.getAttribute('aria-expanded') !== 'true';
    setSettingsMenuState(nextState);
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (!settingsMenu?.contains(target) && !settingsButton?.contains(target)) {
      setSettingsMenuState(false);
    }
  });

  themeToggle?.addEventListener('change', () => {
    updateThemeThumb(themeToggle);
    setTheme(themeToggle.checked ? 'dark' : 'light');
  });
  mobileThemeToggle?.addEventListener('change', () => {
    updateThemeThumb(mobileThemeToggle);
    setTheme(mobileThemeToggle.checked ? 'dark' : 'light');
  });

  const setMenuState = (isOpen: boolean) => {
    document.body.classList.toggle('menu-open', isOpen);
    primaryMenu?.setAttribute('data-open', String(isOpen));
    menuToggle?.setAttribute('aria-expanded', String(isOpen));
    const label = isOpen ? menuToggle?.dataset.closeLabel : menuToggle?.dataset.openLabel;
    if (label) {
      menuToggle?.setAttribute('aria-label', label);
      menuToggle?.setAttribute('title', label);
    }
  };

  menuToggle?.addEventListener('pointerdown', () => {
    menuOpenedByPointer = true;
  });

  menuToggle?.addEventListener('click', (event) => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    setMenuState(!isOpen);

    if (menuOpenedByPointer || event.detail > 0) {
      requestAnimationFrame(() => menuToggle.blur());
      menuOpenedByPointer = false;
    }
  });

  primaryMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });

  const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

  const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';

  const syncNavState = () => {
    const currentPath = normalizePath(window.location.pathname);
    const currentHash = window.location.hash;

    document.querySelectorAll<HTMLAnchorElement>('.site-nav-link').forEach((link) => {
      const targetUrl = new URL(link.href);
      const targetPath = normalizePath(targetUrl.pathname);
      const targetHash = targetUrl.hash;
      const isActive = targetHash
        ? targetPath === currentPath && currentHash === targetHash
        : targetPath === currentPath && currentHash === '';

      link.dataset.active = String(isActive);
      if (isActive) {
        link.setAttribute('aria-current', targetHash ? 'location' : 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  syncNavState();
  window.addEventListener('hashchange', syncNavState);
  window.addEventListener('popstate', syncNavState);

  const updateLanguageSelection = () => {
    document.querySelectorAll<HTMLButtonElement>('.language-option, .mobile-language-option').forEach((button) => {
      const isSelected = button.dataset.locale === (window.location.pathname.includes('/en-us/') ? 'en-us' : 'es-co');
      button.setAttribute('aria-pressed', String(isSelected));
      button.classList.toggle('text-primary', isSelected);
      const label = button.querySelector<HTMLElement>('.language-label');
      if (label) label.classList.toggle('text-primary', isSelected);
    });
  };

  document.querySelectorAll<HTMLButtonElement>('.language-option, .mobile-language-option').forEach((button) => {
    button.addEventListener('click', () => {
      const nextLocale = button.dataset.locale === 'en-us' ? 'en-us' : 'es-co';
      const nextPath = `${basePath}${nextLocale}/`;

      if (window.location.pathname === nextPath) return;

      try {
        if (languageStorageKey) localStorage.setItem(languageStorageKey, nextLocale);
      } catch {}

      sessionStorage.setItem(localeScrollStorageKey, String(window.scrollY));
      setMenuState(false);
      setSettingsMenuState(false);
      window.location.assign(nextPath);
    });
  });

  updateLanguageSelection();

  systemTheme.addEventListener('change', (event) => {
    try {
      if (!localStorage.getItem(themeStorageKey)) setTheme(event.matches ? 'dark' : 'light', false);
    } catch {
      setTheme(event.matches ? 'dark' : 'light', false);
    }
  });
</script>

