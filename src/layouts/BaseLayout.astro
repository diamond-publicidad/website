---
import BackToTop from '../components/BackToTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import type { Locale, Translations } from '../i18n';

interface Props {
  description: string;
  locale: Locale;
  title: string;
  translations: Translations;
}

const { description, locale, title, translations } = Astro.props;
const siteBasePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const faviconIcoHref = `${siteBasePath}favicon.ico`;
const faviconSvgHref = `${siteBasePath}favicon.svg`;
const favicon32Href = `${siteBasePath}favicon-32x32.svg`;
const favicon64Href = `${siteBasePath}favicon-64x64.svg`;
const favicon128Href = `${siteBasePath}favicon-128x128.svg`;
const favicon256Href = `${siteBasePath}favicon-256x256.svg`;
---

<!doctype html>
<html lang={locale.code}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={faviconSvgHref} type="image/svg+xml" />
    <link rel="icon" href={favicon32Href} type="image/svg+xml" sizes="32x32" />
    <link rel="icon" href={favicon64Href} type="image/svg+xml" sizes="64x64" />
    <link rel="icon" href={favicon128Href} type="image/svg+xml" sizes="128x128" />
    <link rel="icon" href={favicon256Href} type="image/svg+xml" sizes="256x256" />
    <link rel="icon" href={faviconIcoHref} type="image/x-icon" sizes="any" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const initialThemeStorageKey = 'diamond-publicidad-theme';
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem(initialThemeStorageKey);
        } catch {
          storedTheme = null;
        }

        const initialTheme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        document.documentElement.dataset.theme = initialTheme;
        document.documentElement.style.colorScheme = initialTheme;
      })();
    </script>
  </head>
  <body>
    <SiteHeader locale={locale} translations={translations} />
    <slot />
    <SiteFooter translations={translations} />
    <BackToTop translations={translations} />
  </body>
</html>