---
import HomePage from '../../components/HomePage.astro';
import { isLocaleSlug, localeSlugs, locales, translations } from '../../i18n';

export function getStaticPaths() {
  return localeSlugs.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;

if (!localeParam || !isLocaleSlug(localeParam)) {
  throw new Error('Unsupported locale route');
}

const locale = locales[localeParam];
const localeTranslations = translations[localeParam];
---

<HomePage locale={locale} translations={localeTranslations} />