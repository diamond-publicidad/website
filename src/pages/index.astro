---
import { icon } from '@fortawesome/fontawesome-svg-core';
import {
  faArrowUp,
  faArrowUpRightFromSquare,
  faBars,
  faBullhorn,
  faEnvelope,
  faLocationDot,
  faMoon,
  faPenRuler,
  faPhone,
  faPrint,
  faSun,
  faXmark,
} from '@fortawesome/free-solid-svg-icons';
import { faFacebook, faWhatsapp } from '@fortawesome/free-brands-svg-icons';
import '../styles/global.css';

const phone = '57 3203898548';
const phoneHref = 'tel:+573203898548';
const email = 'nelsongleon@gmail.com';
const address = 'Cll 12 # 16 - 18, Funza, Colombia';
const whatsappHref = 'https://wa.me/573203898548?text=Hola%2C%20me%20comunico%20para%20cotizar';
const facebookHref = 'https://www.facebook.com/diamondpublicidadleon/';
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const currentYear = new Date().getFullYear();
const arrowIcon = icon(faArrowUpRightFromSquare).html.join('');
const whatsappIcon = icon(faWhatsapp).html.join('');
const phoneIcon = icon(faPhone).html.join('');
const emailIcon = icon(faEnvelope).html.join('');
const facebookIcon = icon(faFacebook).html.join('');
const locationIcon = icon(faLocationDot).html.join('');
const moonIcon = icon(faMoon).html.join('');
const sunIcon = icon(faSun).html.join('');
const menuIcon = icon(faBars).html.join('');
const closeIcon = icon(faXmark).html.join('');
const backToTopIcon = icon(faArrowUp).html.join('');
const printIcon = icon(faPrint).html.join('');
const advertisingIcon = icon(faBullhorn).html.join('');
const designIcon = icon(faPenRuler).html.join('');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Diamond Publicidad: publicidad, impresión digital y soluciones gráficas en Colombia." />
    <title>Diamond Publicidad | Publicidad y soluciones gráficas</title>
    <script is:inline>
      const initialThemeStorageKey = 'diamond-publicidad-theme';
      let storedTheme = null;

      try {
        storedTheme = localStorage.getItem(initialThemeStorageKey);
      } catch {
        storedTheme = null;
      }

      const initialTheme = storedTheme === 'light' || storedTheme === 'dark'
        ? storedTheme
        : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

      document.documentElement.dataset.theme = initialTheme;
    </script>
  </head>
  <body>
    <header class="theme-header sticky top-0 z-40 border-b border-border backdrop-blur-sm">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-5 sm:px-8 lg:px-12">
        <a class="scroll-top flex items-center gap-3 no-underline" href="#inicio" aria-label="Diamond Publicidad, inicio">
          <span class="h-8 w-2 bg-primary" aria-hidden="true"></span>
          <span class="text-base font-extrabold tracking-tight text-secondary sm:text-lg">Diamond Publicidad</span>
        </a>
        <nav aria-label="Navegación principal">
          <div id="primary-menu" class="mobile-menu">
            <div class="mobile-menu-links">
              <p class="mobile-menu-heading">Navegación</p>
              <ul class="flex items-center gap-4 text-sm font-semibold text-text-muted sm:gap-7">
                <li><a class="nav-link no-underline hover:text-secondary" href="#servicios">Servicios</a></li>
                <li><a class="nav-link no-underline hover:text-secondary" href="#contacto">Contacto</a></li>
              </ul>
            </div>
            <div class="mobile-menu-config">
              <p class="mobile-menu-heading">Configuración</p>
              <div class="theme-toggle inline-flex h-10 items-center gap-3 text-sm font-semibold">
                <label class="theme-switch-control cursor-pointer" title="Cambiar tema">
                  <input id="theme-toggle" class="theme-checkbox" type="checkbox" role="switch" aria-checked="false" aria-label="Usar tema oscuro" />
                  <span class="theme-switch-track" aria-hidden="true">
                    <span class="theme-icon theme-icon-moon inline-flex h-4 w-4 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" set:html={moonIcon}></span>
                    <span class="theme-icon theme-icon-sun inline-flex h-4 w-4 shrink-0 items-center justify-center" set:html={sunIcon}></span>
                    <span class="theme-switch-thumb"></span>
                  </span>
                </label>
                <span class="theme-label">Tema oscuro</span>
              </div>
            </div>
          </div>
          <button id="menu-toggle" class="menu-toggle inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-md border border-border text-secondary transition duration-200 sm:hidden" type="button" aria-controls="primary-menu" aria-expanded="false" aria-label="Abrir menú" title="Abrir menú">
            <span class="menu-icon menu-icon-open inline-flex h-5 w-5 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={menuIcon}></span>
            <span class="menu-icon menu-icon-close inline-flex h-5 w-5 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={closeIcon}></span>
          </button>
        </nav>
      </div>
    </header>

    <main id="inicio">
      <section class="relative overflow-hidden border-b border-border bg-surface" aria-labelledby="page-title">
        <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:px-12 lg:py-32">
          <div class="relative z-10">
            <p class="mb-6 flex items-center gap-3 text-sm font-bold uppercase tracking-[0.18em] text-text-muted">
              <span class="h-2 w-2 bg-primary" aria-hidden="true"></span>
              Diamond Publicidad
            </p>
            <h1 id="page-title" class="max-w-4xl text-5xl font-extrabold leading-[1.05] tracking-tight text-secondary sm:text-6xl lg:text-8xl">
              Publicidad que toma forma.
            </h1>
            <p class="mt-8 max-w-2xl text-lg leading-8 text-text-muted sm:text-xl">
              Empresa colombiana dedicada a la publicidad, la impresión digital y las soluciones gráficas.
            </p>
            <div class="mt-10 flex flex-wrap gap-4">
              <a class="hero-action inline-flex min-h-12 items-center justify-center rounded-md bg-primary px-6 py-3 font-bold text-secondary no-underline transition duration-200 hover:-translate-y-0.5 hover:bg-secondary" href="#contacto">Hablemos de tu proyecto <span class="ml-3 inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={arrowIcon}></span></a>
              <a class="hero-action-outline inline-flex min-h-12 items-center justify-center rounded-md border border-secondary px-6 py-3 font-bold text-secondary no-underline transition duration-200 hover:-translate-y-0.5 hover:bg-secondary" href="#servicios">Conoce más</a>
            </div>
          </div>
          <div class="relative min-h-64 overflow-hidden border-2 border-secondary bg-secondary p-7 text-white sm:min-h-72 lg:min-h-96 lg:p-10" aria-label="Identidad de Diamond Publicidad">
            <div class="absolute right-0 top-0 h-24 w-24 border-b-2 border-l-2 border-primary sm:h-32 sm:w-32" aria-hidden="true"></div>
            <span class="pointer-events-none absolute -bottom-8 -right-6 h-56 w-56 text-white/10 [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={printIcon}></span>
            <div class="flex h-full flex-col justify-between gap-10">
              <span class="relative inline-flex h-16 w-16 items-center justify-center text-primary [&>svg]:h-12 [&>svg]:w-12" aria-hidden="true" set:html={printIcon}></span>
              <div>
                <span class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Soluciones gráficas</span>
                <p class="mt-5 max-w-xs text-3xl font-bold leading-tight sm:text-4xl">Una presencia clara para una marca que comunica.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="servicios" class="scroll-mt-8 border-y border-border bg-surface" aria-labelledby="services-title">
        <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12">
          <div class="flex flex-col gap-5 border-b border-border pb-10 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.18em] text-text-muted">Lo que hacemos</p>
              <h2 id="services-title" class="mt-4 text-3xl font-extrabold tracking-tight text-secondary sm:text-4xl">Servicios</h2>
            </div>
            <p class="max-w-xl text-lg leading-8 text-text-muted">Soluciones gráficas para llevar una idea desde el diseño hasta una pieza lista para comunicar.</p>
          </div>
          <div class="mt-10 grid gap-5 lg:grid-cols-3">
            <article class="service-card group relative overflow-hidden rounded-md border-l-4 border-primary bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-secondary hover:shadow-sm sm:p-7">
              <span class="pointer-events-none absolute -bottom-5 -right-4 h-32 w-32 text-secondary/5 transition-colors duration-200 group-hover:text-primary/15 [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={printIcon}></span>
              <span class="service-icon relative inline-flex h-11 w-11 items-center justify-center bg-secondary text-primary transition-colors duration-200 group-hover:bg-primary group-hover:text-secondary [&>svg]:h-5 [&>svg]:w-5" aria-hidden="true" set:html={printIcon}></span>
              <h3 class="mt-7 text-xl font-extrabold leading-tight text-secondary">Impresión digital a gran formato</h3>
              <p class="mt-4 text-base leading-7 text-text-muted">Materiales para piezas de gran formato:</p>
              <ul class="mt-5 grid gap-3 border-t border-border pt-5 text-sm font-semibold text-secondary">
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Banner</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Vinilo adhesivo</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Microperforado</li>
              </ul>
            </article>
            <article class="service-card group relative overflow-hidden rounded-md border-l-4 border-primary bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-secondary hover:shadow-sm sm:p-7">
              <span class="pointer-events-none absolute -bottom-5 -right-4 h-32 w-32 text-secondary/5 transition-colors duration-200 group-hover:text-primary/15 [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={advertisingIcon}></span>
              <span class="service-icon relative inline-flex h-11 w-11 items-center justify-center bg-secondary text-primary transition-colors duration-200 group-hover:bg-primary group-hover:text-secondary [&>svg]:h-5 [&>svg]:w-5" aria-hidden="true" set:html={advertisingIcon}></span>
              <h3 class="mt-7 text-xl font-extrabold leading-tight text-secondary">Avisos y publicidad exterior</h3>
              <p class="mt-4 text-base leading-7 text-text-muted">Piezas para identificar, promocionar y dar visibilidad:</p>
              <ul class="mt-5 grid gap-3 border-t border-border pt-5 text-sm font-semibold text-secondary">
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Avisos</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Avisos en cajas de luz</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Vallas y pendones</li>
              </ul>
            </article>
            <article class="service-card group relative overflow-hidden rounded-md border-l-4 border-primary bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-secondary hover:shadow-sm sm:p-7">
              <span class="pointer-events-none absolute -bottom-5 -right-4 h-32 w-32 text-secondary/5 transition-colors duration-200 group-hover:text-primary/15 [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={designIcon}></span>
              <span class="service-icon relative inline-flex h-11 w-11 items-center justify-center bg-secondary text-primary transition-colors duration-200 group-hover:bg-primary group-hover:text-secondary [&>svg]:h-5 [&>svg]:w-5" aria-hidden="true" set:html={designIcon}></span>
              <h3 class="mt-7 text-xl font-extrabold leading-tight text-secondary">Diseño y piezas impresas</h3>
              <p class="mt-4 text-base leading-7 text-text-muted">Recursos para comunicar una marca en distintos formatos:</p>
              <ul class="mt-5 grid gap-3 border-t border-border pt-5 text-sm font-semibold text-secondary">
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Tarjetas de presentación</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Botones y volantes</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 shrink-0 bg-primary" aria-hidden="true"></span>Diseños</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="border-y border-border bg-surface" aria-labelledby="portfolio-title">
        <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-[0.7fr_1.3fr] lg:px-12">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-text-muted">Trabajo real</p>
            <h2 id="portfolio-title" class="mt-4 text-3xl font-extrabold tracking-tight text-secondary sm:text-4xl">Portafolio</h2>
          </div>
          <div class="border-t border-border pt-6">
            <p class="max-w-2xl text-lg leading-8 text-text-muted">El portafolio estará disponible cuando existan piezas aprobadas para compartir.</p>
            <p class="mt-6 inline-flex rounded-md border border-border bg-white px-4 py-3 text-sm font-semibold text-secondary">Próximamente</p>
          </div>
        </div>
      </section>

      <section id="contacto" class="scroll-mt-8 bg-secondary text-white" aria-labelledby="contact-title">
        <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-[0.8fr_1.2fr] lg:px-12">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">Contacto</p>
            <h2 id="contact-title" class="mt-4 text-3xl font-extrabold tracking-tight sm:text-5xl">Hablemos.</h2>
            <p class="mt-6 max-w-md leading-7 text-gray-300">Encuentra a Diamond Publicidad en Funza, Colombia.</p>
            <a class="whatsapp-action mt-8 inline-flex min-h-12 items-center rounded-md bg-primary px-6 py-3 font-bold no-underline transition duration-200 hover:-translate-y-0.5 hover:bg-white" href={whatsappHref} target="_blank" rel="noreferrer"><span class="mr-3 inline-flex h-5 w-5 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={whatsappIcon}></span>Escribir por WhatsApp</a>
          </div>
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-primary">Canales</h3>
              <address class="mt-5 grid gap-3 not-italic leading-7 text-gray-200">
                <a class="inline-flex w-fit items-center gap-2 hover:text-primary" href={phoneHref}><span class="inline-flex h-4 w-4 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={phoneIcon}></span>Tel. {phone}</a>
                <a class="inline-flex w-fit items-center gap-2 break-all hover:text-primary" href={`mailto:${email}`}><span class="inline-flex h-4 w-4 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={emailIcon}></span>{email}</a>
                <a class="facebook-link inline-flex w-fit items-center gap-2 font-semibold text-white underline decoration-primary decoration-2 underline-offset-4 transition duration-200 hover:text-primary" href={facebookHref} target="_blank" rel="noreferrer"><span class="inline-flex h-4 w-4 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={facebookIcon}></span>Facebook<span class="sr-only">, abrir página externa</span></a>
              </address>
            </div>
            <div>
              <h3 class="text-sm font-bold uppercase tracking-[0.15em] text-primary">Ubicación</h3>
              <address class="mt-5 flex items-start gap-2 not-italic leading-7 text-gray-200"><span class="mt-1 inline-flex h-4 w-4 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={locationIcon}></span><span>{address}</span></address>
              <a class="mt-4 inline-flex items-center gap-2 font-semibold text-white underline decoration-primary decoration-2 underline-offset-4 hover:text-primary" href={mapHref} target="_blank" rel="noreferrer">Abrir en Google Maps<span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={arrowIcon}></span></a>
            </div>
            <div class="overflow-hidden rounded-md border border-gray-700 sm:col-span-2">
              <iframe class="h-64 w-full border-0 grayscale sm:h-72" src={mapEmbedSrc} title={`Mapa de ubicación: ${address}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-secondary px-5 pb-28 text-sm text-gray-400 sm:px-8 sm:pb-20 lg:px-12">
      <div class="mx-auto flex max-w-7xl justify-center border-t border-gray-700 pt-6 text-center">
        <div class="flex flex-col items-center gap-1">
          <p>© {currentYear} Diamond Publicidad. Todos los derechos reservados.</p>
          <p>Hecho por <a class="inline-flex items-center gap-2 font-semibold text-white underline decoration-primary decoration-2 underline-offset-4 transition-colors hover:text-primary" href="https://github.com/xhate83" target="_blank" rel="noreferrer" aria-label="Julian Ospina Dev en GitHub">Julian Ospina Dev <span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={arrowIcon}></span></a></p>
        </div>
      </div>
    </footer>

    <a id="back-to-top" class="scroll-top fixed bottom-5 right-5 z-30 inline-flex translate-y-4 items-center gap-2 rounded-full border border-secondary bg-primary px-4 py-3 text-sm font-bold text-secondary opacity-0 shadow-lg transition duration-200 pointer-events-none hover:-translate-y-0.5 hover:bg-white" href="#inicio" aria-label="Volver al inicio"><span class="inline-flex h-4 w-4 shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={backToTopIcon}></span><span class="hidden sm:inline">Arriba</span></a>

    <script>
      const themeStorageKey = 'diamond-publicidad-theme';
      const themeToggle = document.querySelector<HTMLInputElement>('#theme-toggle');
      const menuToggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const primaryMenu = document.querySelector('#primary-menu');
      const themeLabel = document.querySelector('.theme-label');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      let menuOpenedByPointer = false;

      const updateThemeControl = (theme: 'light' | 'dark') => {
        const isDark = theme === 'dark';

        if (themeToggle) {
          themeToggle.checked = isDark;
        }

        themeToggle?.setAttribute('aria-checked', String(isDark));
        themeToggle?.setAttribute('aria-label', isDark ? 'Tema oscuro' : 'Tema claro');

        if (themeLabel) {
          themeLabel.textContent = isDark ? 'Tema oscuro' : 'Tema claro';
        }
      };

      const setTheme = (theme: 'light' | 'dark', persist = true) => {
        document.documentElement.dataset.theme = theme;
        updateThemeControl(theme);

        if (persist) {
          try {
            localStorage.setItem(themeStorageKey, theme);
          } catch {
            // La interfaz sigue funcionando si el navegador bloquea el almacenamiento local.
          }
        }
      };

      const currentTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      updateThemeControl(currentTheme);

      themeToggle?.addEventListener('change', () => {
        setTheme(themeToggle.checked ? 'dark' : 'light');
      });

      const setMenuState = (isOpen: boolean) => {
        document.body.classList.toggle('menu-open', isOpen);
        primaryMenu?.setAttribute('data-open', String(isOpen));
        menuToggle?.setAttribute('aria-expanded', String(isOpen));
        menuToggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
        menuToggle?.setAttribute('title', isOpen ? 'Cerrar menú' : 'Abrir menú');
      };

      menuToggle?.addEventListener('pointerdown', () => {
        menuOpenedByPointer = true;
      });

      menuToggle?.addEventListener('click', (event) => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        setMenuState(!isOpen);

        if (menuOpenedByPointer || event.detail > 0) {
          requestAnimationFrame(() => menuToggle.blur());
          menuOpenedByPointer = false;
        }
      });

      primaryMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuState(false));
      });

      const scrollToTop = (event: MouseEvent) => {
        event.preventDefault();
        const scrollingElement = document.scrollingElement;

        scrollingElement?.scrollTo({
          top: 0,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      };

      document.querySelectorAll<HTMLAnchorElement>('.scroll-top').forEach((link) => {
        link.addEventListener('click', scrollToTop);
      });

      systemTheme.addEventListener('change', (event) => {
        try {
          if (!localStorage.getItem(themeStorageKey)) {
            setTheme(event.matches ? 'dark' : 'light', false);
          }
        } catch {
          setTheme(event.matches ? 'dark' : 'light', false);
        }
      });

      const backToTop = document.querySelector('#back-to-top');

      if (backToTop) {
        const updateBackToTop = () => {
          const isVisible = window.scrollY > 480;
          backToTop.classList.toggle('opacity-0', !isVisible);
          backToTop.classList.toggle('translate-y-4', !isVisible);
          backToTop.classList.toggle('pointer-events-none', !isVisible);
        };

        window.addEventListener('scroll', updateBackToTop, { passive: true });
        updateBackToTop();
      }
    </script>
  </body>
</html>