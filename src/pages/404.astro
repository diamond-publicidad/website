---
import { defaultLocale, getLocalePath, languageStorageKey } from '../i18n';

const fallbackPath = getLocalePath(defaultLocale);
---

<!doctype html>
<html lang="es-CO" data-fallback-path={fallbackPath} data-default-locale={defaultLocale} data-language-storage-key={languageStorageKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${fallbackPath}`} />
    <script>
      (() => {
        const defaultLocale = document.documentElement.dataset.defaultLocale ?? 'es-co';
        const languageStorageKey = document.documentElement.dataset.languageStorageKey ?? '';
        const fallbackPath = document.documentElement.dataset.fallbackPath ?? '/';
        let locale = null;

        try {
          locale = languageStorageKey ? localStorage.getItem(languageStorageKey) : null;
        } catch {}

        const allowedLocale = locale === 'en-us' || locale === 'es-co' ? locale : defaultLocale;
        const basePath = fallbackPath.replace(/(?:es-co|en-us)\/$/, '');
        window.location.replace(`${basePath}${allowedLocale}/`);
      })();
    </script>
  </head>
  <body></body>
</html>
